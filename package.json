{
  "name": "docling-serve-client",
  "version": "0.5.0",
  "description": "Typed docling-serve client: PDF to docling Markdown or DoclingDocument JSON, sync and async. In-memory, zero-dependency, never throws.",
  "keywords": [
    "pdf",
    "markdown",
    "docling",
    "docling-serve",
    "pdf-to-markdown",
    "docling-document"
  ],
  "author": "Martin Winkler",
  "license": "Apache-2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martin-winkler-dev/docling-serve-client-js.git"
  },
  "bugs": {
    "url": "https://github.com/martin-winkler-dev/docling-serve-client-js/issues"
  },
  "homepage": "https://github.com/martin-winkler-dev/docling-serve-client-js#readme",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun run build:types && bun run build:js",
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target node --format esm --packages external --sourcemap=linked --banner=\"/*! Copyright 2026 Martin Winkler. SPDX-License-Identifier: Apache-2.0 */\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run test:types",
    "test": "bun test --only-failures && bun run test:types",
    "test:e2e": "DOCLING_E2E=1 bun test tests/e2e",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:dist": "node tests/smoke/smoke.mjs && node tests/smoke/smoke.cjs",
    "test:package": "attw --pack . --profile esm-only",
    "coverage": "bun test --coverage",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "lint:ci": "biome ci --error-on-warnings .",
    "check": "bun run lint:ci && bun run test && bun run build && bun run test:dist && bun run test:package",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.20.5",
    "bun-test-runner": "latest",
    "smartin": "latest",
    "typescript": "^7.0.2"
  }
}
